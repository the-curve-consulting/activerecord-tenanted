#!/usr/bin/env bash
set -euo pipefail

bundle install

for tool in actionlint shellcheck zizmor; do
  if ! command -v "$tool" &> /dev/null; then
    if command -v brew &> /dev/null; then
      brew install "$tool"
    elif command -v pacman &> /dev/null; then
      sudo pacman -S --noconfirm "$tool"
    else
      echo "Error: install $tool manually" >&2
      exit 1
    fi
  fi
done

#  The MySQL and PostgreSQL test scenarios need a database server. bin/db-servers starts them,
#  and CI runs the same script, so a developer and CI use servers with the same settings.
#
"${BASH_SOURCE%/*}"/db-servers
