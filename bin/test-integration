#!/usr/bin/env ruby

GEM_PATH     = File.expand_path(File.join(__dir__, "../"))
SMARTY_PATH  = File.join(GEM_PATH, "test/smarty")
GEMFILE      = File.expand_path(ENV["BUNDLE_GEMFILE"] || File.join(GEM_PATH, "Gemfile"))
OVERLAY_PATH = File.join(GEM_PATH, "test/integration")

TEST_ARGS = ARGV.dup
OPT_KEEP_DIR = TEST_ARGS.delete("--keep") # keep the test tempdirs around for examination

ENV["BUNDLE_GEMFILE"] = GEMFILE
require "bundler/setup"

PARALLEL = ENV["NCPU"].to_i > 1

require "fileutils"
require "securerandom"
require "tmpdir"
require "yaml"
require "open3"
require "active_support"
require "active_support/core_ext/object" # presence

# The scenarios run against SQLite, unless ARTENANT_ADAPTERS names other adapters as a comma
# separated list. A scenario belongs to the adapter of its tenanted database.
SCENARIO_ADAPTERS = (ENV["ARTENANT_ADAPTERS"] || "sqlite3").split(",").map(&:strip)

# Each run prefixes the database names of its scenario apps, so that two runs do not use the same
# database on a server that they share. Each app adds to the prefix, because two scenarios can
# name a database the same way. The prefix is written into the config/database.yml of the app, so
# every command of that app uses the same databases.
RUN_ID = "art#{SecureRandom.hex(3)}"

def scenario_adapter(database)
  YAML.load_file("test/scenarios/#{database}/database.yml")
      .fetch("test")
      .each_value
      .find { |db_config| db_config["tenanted"] }
      &.fetch("adapter")
end

scenarios = Dir.glob("test/scenarios/*db/*record.rb").filter_map do |path|
  database, models = path.scan(%r{test/scenarios/(.+db)/(.+record).rb}).flatten
  next unless SCENARIO_ADAPTERS.include?(scenario_adapter(database))

  { database: database, models: models }
end

if scenarios.empty?
  abort("ERROR: No test scenario uses an adapter in #{SCENARIO_ADAPTERS.inspect}. " \
        "Check the ARTENANT_ADAPTERS environment variable.")
end

COLOR_FG_BLUE = "\e[0;34m"
COLOR_RESET = "\e[0m"

def run_cmd(scenario, cmd, verbose: false, env: {}, abort_on_failure: true)
  message = "#{COLOR_FG_BLUE}#{scenario}#{COLOR_RESET} > #{env.presence} #{cmd}"
  print message + (PARALLEL ? "\n" : "")

  output = status = nil
  elapsed = ActiveSupport::Benchmark.realtime do
    output, status = Open3.capture2e(env, cmd)
  end

  puts " (#{elapsed.round(2)}s)" if !PARALLEL
  puts output if verbose || !status.success? || ENV["CI"]

  return status.success? unless abort_on_failure

  abort("ERROR: Command failed") unless status.success?

  true
end

# Drops the databases of the app. A SQLite database is a file in the app directory, which is
# removed with the directory. A database on a server stays until it is dropped, so a run would
# leave a database behind for each scenario and for each tenant that the tests made.
#
# A failure here does not stop the run, because it must not hide the result of the tests.
def drop_databases(scenario)
  %w[test development].each do |env|
    run_cmd(scenario, "bin/rails db:drop", env: { "RAILS_ENV" => env }, abort_on_failure: false)
  end
end

def run_scenario(scenario)
  # setup the test directory and cleanup
  app_path = Dir.mktmpdir("activerecord-tenanted-integration-test-")
  at_exit { FileUtils.remove_entry app_path } unless OPT_KEEP_DIR
  puts "Creating integration app for #{COLOR_FG_BLUE}#{scenario}#{COLOR_RESET} at #{app_path}"

  # make a copy of the smarty app
  FileUtils.copy_entry(SMARTY_PATH, app_path)

  # Generate the database file. The scenario template is read once for each environment, with the
  # name of the environment in %{env}, so that the two environments never name the same database.
  # A SQLite scenario puts the environment in the path, and a server scenario puts it in the
  # database name.
  database_file = File.join(GEM_PATH, "test/scenarios/#{scenario[:database]}/database.yml")
  database_template = File.read(database_file)
  database_prefix = "#{RUN_ID}#{SecureRandom.hex(2)}"

  database_file_hash = %w[test development].each_with_object({}) do |env, result|
    contents = sprintf(database_template,
                       storage: "storage", db_path: "db",
                       prefix: database_prefix, env: env,
                       mysql_port: ENV.fetch("ARTENANT_MYSQL_PORT", 13306),
                       postgres_port: ENV.fetch("ARTENANT_POSTGRES_PORT", 15432))

    result[env] = YAML.load(contents).fetch("test")
  end

  File.write(File.join(app_path, "config/database.yml"), database_file_hash.to_yaml)

  # generate models using ApplicationRecord
  models_file = File.join(GEM_PATH, "test/scenarios/#{scenario[:database]}/#{scenario[:models]}.rb")
  models_file_contents = File.read(models_file)
                           .gsub("TenantedApplicationRecord", "ApplicationRecord")
  File.write(File.join(app_path, "app/models/application_record.rb"), models_file_contents)

  # copy migrations from scenario and smarty app
  FileUtils.mkdir_p(File.join(app_path, "db"))
  FileUtils.cp_r(Dir.glob(File.join(GEM_PATH, "test/scenarios/#{scenario[:database]}/*migrations")),
                 File.join(app_path, "db"))
  FileUtils.cp_r(Dir.glob(File.join(app_path, "db/migrate/*rb")),
                 File.join(app_path, "db/tenanted_migrations"))

  # copy overlay tests and tenanting config
  FileUtils.cp_r(Dir.glob(File.join(OVERLAY_PATH, "*")), app_path)

  Dir.chdir(app_path) do
    Bundler.with_original_env do
      run_cmd(scenario, "bundle check || bundle install")

      # set up the database and schema files
      run_cmd(scenario, "bin/rails db:prepare")

      # validate-ish the setup
      prefix = scenario[:database].match?(/\Asecondary/) ? "tenanted_" : ""
      File.exist?("db/#{prefix}schema.rb") || abort("Schema dump not generated")
      File.exist?("db/#{prefix}schema_cache.yml") || abort("Schema cache dump not generated")

      # create a tenant that the test suite must delete when it starts
      run_cmd(scenario, "bin/rails db:migrate", env: { "RAILS_ENV" => "test", "ARTENANT" => "delete-me" })

      # validate-ish the tenant, so that the test that looks for it cannot pass for the wrong reason
      check = %q{ApplicationRecord.tenants.include?("delete-me") || abort("tenant not created")}
      run_cmd(scenario, "bin/rails runner -e test '#{check}'")

      # run in parallel half the time
      env = if rand(2).zero?
        { "PARALLEL_WORKERS" => "2" }
      else
        { "PARALLEL_WORKERS" => "1" }
      end

      run_cmd(scenario, ["bin/rails test", *TEST_ARGS].join(" "), verbose: true, env:)
    ensure
      drop_databases(scenario)
      ENV["BUNDLE_GEMFILE"] = nil
    end
  end
end

if PARALLEL
  processes = {}

  scenarios.each do |scenario|
    processes[scenario] = Process.fork do
      run_scenario(scenario)
    end
  end

  statuses = {}

  processes.each do |scenario, pid|
    statuses[scenario] = Process::Status.wait(pid)
  end

  failure = false
  statuses.each do |scenario, status|
    scenario = "#{COLOR_FG_BLUE}#{scenario}#{COLOR_RESET}"
    if status.success?
      puts "Scenario #{scenario} succeeded."
    else
      puts "Scenario #{scenario} FAILED."
      failure = true
    end
  end
  exit(1) if failure
else
  scenarios.each do |scenario|
    run_scenario(scenario)
  end
end
